generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// `day` is always the Africa/Addis_Ababa calendar date as "YYYY-MM-DD".

// `code` is what the phone stores to get back to the family. It is the only
// credential, so treat it like a password: never log it.
model Family {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  children Child[]
}

model Child {
  id        String   @id @default(uuid())
  familyId  String
  age       Int
  language  String
  nickname  String?
  createdAt DateTime @default(now())

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  dailyMissions DailyMission[]
  completions   Completion[]
  gameResults   GameResult[]
}

model DailyMission {
  id        String   @id @default(uuid())
  childId   String
  day       String
  missions  Json
  source    String
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, day])
}

model Completion {
  id          String   @id @default(uuid())
  childId     String
  missionId   String
  day         String
  points      Int
  verifiedBy  String
  result      Json?
  completedAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, missionId, day])
  @@index([childId, day])
}

model GameResult {
  id        String   @id @default(uuid())
  childId   String
  day       String
  game      String
  score     Int
  points    Int
  result    Json
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, day, game])
}
