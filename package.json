{
  "name": "lelije",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "ai"
  ],
  "scripts": {
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "dev": "npm run build && node backend/dist/main.js",
    "start": "node backend/dist/main.js",
    "lint": "npm run lint --workspace=frontend",
    "test:ai": "npm test --workspace=ai",
    "test:backend": "npm test --workspace=backend",
    "test:frontend": "npm test --workspace=frontend",
    "test": "npm run test:ai && npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@google/genai": "^3.6.1"
  }
}
